---
import { Image } from 'astro:assets';
import logo from '../assets/marca/logo.png';
import { site } from '../data/site';
import { url } from '../lib/url';
import Icone from './Icone.astro';

const ano = new Date().getFullYear();
---

<footer class="rodape">
  <div class="contem topo">
    <a class="marca" href={url()}>
      <Image src={logo} width={44} height={44} densities={[2, 3]} alt="" />
      <span>{site.nome}</span>
    </a>
    <a class="insta" href={site.instagram.url} target="_blank" rel="noopener noreferrer">
      <Icone nome="instagram" tamanho={18} />
      <span>@{site.instagram.usuario}</span>
    </a>
  </div>

  <!-- Faixa de crédito, no mesmo formato usado nos outros projetos. -->
  <p class="credito">Copyright © {ano} {site.nome} | Powered by Raccoon Digital</p>
</footer>

<style>
  .rodape {
    border-top: 1px solid var(--grafite);
    color: var(--nevoa);
    font-size: var(--t-sm);
  }

  .topo {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-block: 2rem;
  }

  .marca,
  .insta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    text-decoration: none;
  }

  .marca {
    color: var(--osso);
    font-family: var(--fonte-titulo);
    font-size: var(--t-lg);
  }

  .insta:hover {
    color: var(--osso);
  }

  .credito {
    max-width: none;
    padding: 1rem 0.5rem;
    background: var(--carvao);
    border-top: 1px solid var(--grafite);
    text-align: center;
    /* Cabe numa linha em qualquer largura de celular. */
    font-size: clamp(10px, 3.3vw, 14px);
    line-height: 1.3;
  }

  @media (min-width: 48rem) {
    .topo {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
