---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import logo from '../assets/marca/logo.png';
import { site } from '../data/site';
import { url } from '../lib/url';
import { fotosDaCategoria } from '../lib/portfolio';
import BotaoWhatsapp from './BotaoWhatsapp.astro';
import Icone from './Icone.astro';

const categorias = (await getCollection('categorias'))
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .map((categoria) => ({
    id: categoria.id,
    titulo: categoria.data.titulo,
    total: fotosDaCategoria(categoria.id).length,
  }));
---

<header class="cabecalho">
  <div class="contem barra">
    <a class="marca" href={url()} aria-label={`${site.nome}, página inicial`}>
      <Image
        class="marca-logo"
        src={logo}
        width={80}
        height={80}
        densities={[1.5, 1.875]}
        alt=""
        loading="eager"
      />
      <span class="marca-texto">{site.nome}</span>
    </a>

    <button
      class="botao-menu"
      type="button"
      aria-haspopup="dialog"
      aria-controls="menu"
      aria-expanded="false"
    >
      <span class="botao-menu-rotulo">Menu</span>
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
        <path
          d="M3 7h18M3 12h18M3 17h18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>

<dialog id="menu" class="menu" aria-label="Menu principal">
  <div class="menu-conteudo">
    <div class="menu-topo">
      <a class="menu-marca" href={url()}>
        <Image src={logo} width={44} height={44} densities={[2, 3]} alt="" />
        <span>{site.nome}</span>
      </a>
      <button class="menu-fechar" type="button" aria-label="Fechar menu">
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
          <path
            d="M5 5l14 14M19 5L5 19"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <nav aria-label="Principal">
      <h2 class="menu-grupo">Trabalhos</h2>
      <ul class="menu-categorias">
        {
          categorias.map((categoria) => (
            <li>
              <a href={url(`trabalhos/${categoria.id}/`)}>
                <span class="nome">{categoria.titulo}</span>
                <span class="total">{categoria.total > 0 ? categoria.total : 'em breve'}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <ul class="menu-links">
        <li><a href={url('#sobre')}>Sobre</a></li>
        <li><a href={url('#cursos')}>Cursos</a></li>
        <li><a href="#orcamento">Orçamento</a></li>
      </ul>
    </nav>

    <div class="menu-rodape">
      <BotaoWhatsapp rotulo="Pedir orçamento" />
      <a
        class="botao botao--vazado"
        href={site.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icone nome="instagram" />
        <span>Instagram</span>
      </a>
    </div>
  </div>
</dialog>

<script>
  // Cabeçalho ganha fundo (e a logo encolhe) ao rolar.
  const cabecalho = document.querySelector<HTMLElement>('.cabecalho');
  if (cabecalho) {
    const aoRolar = () => cabecalho.toggleAttribute('data-rolou', window.scrollY > 8);
    aoRolar();
    window.addEventListener('scroll', aoRolar, { passive: true });
  }

  // Menu lateral: <dialog> nativo (foco preso, Esc fecha, fundo inerte).
  const menu = document.querySelector<HTMLDialogElement>('#menu');
  const abrir = document.querySelector<HTMLButtonElement>('.botao-menu');
  if (menu && abrir) {
    abrir.addEventListener('click', () => {
      menu.showModal();
      abrir.setAttribute('aria-expanded', 'true');
    });
    menu.addEventListener('close', () => abrir.setAttribute('aria-expanded', 'false'));
    menu.querySelector('.menu-fechar')?.addEventListener('click', () => menu.close());
    menu.addEventListener('click', (evento) => {
      const alvo = evento.target as HTMLElement;
      // Clique no fundo escurecido (o próprio <dialog>) ou em qualquer link fecha o menu.
      if (alvo === menu || alvo.closest('a')) menu.close();
    });
  }
</script>

<style>
  /* ---------- Barra superior ---------- */
  /* No topo da página a logo é grande (altura --topo); ao rolar o cabeçalho
     compacta (altura --topo-compacto) e a logo encolhe junto. */
  .cabecalho {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--topo);
    border-bottom: 1px solid transparent;
    transition:
      height 0.25s cubic-bezier(0.2, 0.7, 0.1, 1),
      background-color 0.25s,
      border-color 0.25s;
  }

  .cabecalho[data-rolou] {
    height: var(--topo-compacto);
    background: color-mix(in srgb, var(--tinta) 88%, transparent);
    border-bottom-color: var(--grafite);
    backdrop-filter: blur(10px);
  }

  .barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    text-decoration: none;
  }

  .marca-logo {
    width: 5rem;
    height: 5rem;
    transition:
      width 0.25s cubic-bezier(0.2, 0.7, 0.1, 1),
      height 0.25s cubic-bezier(0.2, 0.7, 0.1, 1);
  }

  .cabecalho[data-rolou] .marca-logo {
    width: 2.75rem;
    height: 2.75rem;
  }

  /* Nome em letras romanas, como na faixa da logo. */
  .marca-texto,
  .menu-marca {
    font-family: var(--fonte-marca);
    font-size: var(--t-sm);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 22.5rem) {
    .marca-logo {
      width: 3.5rem;
      height: 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cabecalho,
    .marca-logo {
      transition: none;
    }
  }

  .botao-menu {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 0.5rem;
    border: 0;
    border-radius: var(--raio);
    background: transparent;
    font-family: var(--fonte-texto);
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--osso);
    cursor: pointer;
    transition: color 0.18s;
  }

  .botao-menu:hover {
    color: var(--ouro);
  }

  .botao-menu-rotulo {
    display: none;
  }

  @media (min-width: 48rem) {
    .botao-menu-rotulo {
      display: inline;
    }
  }

  /* ---------- Menu lateral ---------- */
  .menu {
    position: fixed;
    inset: 0 0 0 auto;
    margin: 0;
    width: min(26rem, 100vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--grafite);
    background: var(--carvao);
    color: var(--osso);
    overflow: hidden;
  }

  .menu::backdrop {
    background: rgb(6 5 4 / 0.74);
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu[open] {
      animation: entra 0.3s cubic-bezier(0.2, 0.7, 0.1, 1);
    }

    .menu[open]::backdrop {
      animation: esmaece 0.3s ease;
    }
  }

  @keyframes entra {
    from {
      transform: translateX(100%);
    }
  }

  @keyframes esmaece {
    from {
      opacity: 0;
    }
  }

  .menu-conteudo {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0.5rem var(--margem) 1.5rem;
    overflow-y: auto;
  }

  .menu-topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
    margin-bottom: 1rem;
  }

  .menu-marca {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .menu-fechar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: var(--raio);
    background: transparent;
    color: var(--osso);
    cursor: pointer;
  }

  .menu-fechar:hover {
    color: var(--ouro);
  }

  .menu-grupo {
    margin-bottom: 0.5rem;
    font-size: var(--t-base);
    color: var(--ouro);
  }

  .menu-categorias a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--grafite);
    text-decoration: none;
  }

  .menu-categorias .nome {
    font-family: var(--fonte-titulo);
    font-size: var(--t-xl);
    line-height: 1.1;
    transition: color 0.18s;
  }

  .menu-categorias .total {
    color: var(--nevoa);
    font-size: var(--t-sm);
  }

  .menu-categorias a:hover .nome {
    color: var(--ouro);
  }

  .menu-links {
    margin-top: 1.5rem;
  }

  .menu-links a {
    display: block;
    padding-block: 0.7rem;
    font-size: var(--t-lg);
    text-decoration: none;
  }

  .menu-links a:hover {
    color: var(--ouro);
  }

  .menu-rodape {
    display: grid;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 2rem;
  }
</style>
